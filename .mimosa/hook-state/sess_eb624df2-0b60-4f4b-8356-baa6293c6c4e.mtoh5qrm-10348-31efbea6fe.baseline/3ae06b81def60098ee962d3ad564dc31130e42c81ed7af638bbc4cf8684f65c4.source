	        this.minutes = source["minutes"];
	        this.totalChapters = source["totalChapters"];
	        this.totalEpisodes = source["totalEpisodes"];
	    }
	}
	export class Shelf {
	    id: number;
	    name: string;
	    kind: string;
	    position: number;
	    titleIds: number[];
	    createdAt: string;
	
	    static createFrom(source: any = {}) {
	        return new Shelf(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.id = source["id"];
	        this.name = source["name"];
	        this.kind = source["kind"];
	        this.position = source["position"];
	        this.titleIds = source["titleIds"];
	        this.createdAt = source["createdAt"];
	    }
	}
	export class TitleRelation {
	    relatedId: number;
	    label: string;
	    reverseLabel: string;
	    name: string;
	    cover: string;
	    status: string;
	
	    static createFrom(source: any = {}) {
	        return new TitleRelation(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.relatedId = source["relatedId"];
	        this.label = source["label"];
	        this.reverseLabel = source["reverseLabel"];
	        this.name = source["name"];
	        this.cover = source["cover"];
	        this.status = source["status"];
	    }
	}
	export class Title {
	    id: number;
	    type: string;
	    category: string;
	    names: Name[];
	    cover: string;
	    images: string[];
	    synopsis: string;
	    creators: Creator[];
	    genres: string[];
	    tags: string[];
	    relations: TitleRelation[];
	    reverseRelations: TitleRelation[];
	    characters: CharacterRef[];
	    score: number;
	    status: string;
	    releaseStatus: string;
	    customList: string;
	    progress: Progress;
	    notes: string;
	    spineColor: string;
	    createdAt: string;
	    updatedAt: string;
	
	    static createFrom(source: any = {}) {
	        return new Title(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.id = source["id"];
	        this.type = source["type"];
	        this.category = source["category"];
	        this.names = this.convertValues(source["names"], Name);
	        this.cover = source["cover"];
	        this.images = source["images"];
	        this.synopsis = source["synopsis"];
	        this.creators = this.convertValues(source["creators"], Creator);
	        this.genres = source["genres"];
	        this.tags = source["tags"];
	        this.relations = this.convertValues(source["relations"], TitleRelation);
	        this.reverseRelations = this.convertValues(source["reverseRelations"], TitleRelation);
	        this.characters = this.convertValues(source["characters"], CharacterRef);
	        this.score = source["score"];
	        this.status = source["status"];
	        this.releaseStatus = source["releaseStatus"];
	        this.customList = source["customList"];
	        this.progress = this.convertValues(source["progress"], Progress);
	        this.notes = source["notes"];
	        this.spineColor = source["spineColor"];
	        this.createdAt = source["createdAt"];
	        this.updatedAt = source["updatedAt"];
	    }
	
		convertValues(a: any, classs: any, asMap: boolean = false): any {
		    if (!a) {
		        return a;
		    }
		    if (a.slice && a.map) {
		        return (a as any[]).map(elem => this.convertValues(elem, classs));
		    } else if ("object" === typeof a) {
		        if (asMap) {
		            for (const key of Object.keys(a)) {
		                a[key] = new classs(a[key]);
		            }
		            return a;
		        }
		        return new classs(a);
		    }
		    return a;
		}
	}
	

}

export namespace sync {
	
	export class SyncResult {
	    direction: string;
	    uploaded: number;
	    message: string;
	    time: string;
	
	    static createFrom(source: any = {}) {
	        return new SyncResult(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.direction = source["direction"];
	        this.uploaded = source["uploaded"];
	        this.message = source["message"];
	        this.time = source["time"];
	    }
	}
	export class WebDAVConfig {
	    url: string;
	    username: string;
	    password: string;
	    remoteDir: string;
	
	    static createFrom(source: any = {}) {
	        return new WebDAVConfig(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.url = source["url"];
	        this.username = source["username"];
	        this.password = source["password"];
	        this.remoteDir = source["remoteDir"];
	    }
	}

}

